##! Please refer to the documentation at
##! https://coreruleset.org/docs/development/regex_assembly/.

##!+ i

##!> assemble
  \bhaving\s*\(?\s*
  ##!=>
  ##! value: a quoted/unquoted number, a quoted non-digit string, or a boolean literal
  ##!> assemble
    ['"]?\s*\d+\s*['"]?
    ['"]\s*[^\d]*\s*['"]
    true
    false
  ##!<
  ##!=>
  \s*
  ##!=>
  ##! operator: comparison/arithmetic symbols, or a word operator
  ##!> assemble
    [=<>+\-*/%^&!|]+
    div
    mod
  ##!<
##!<

##!> assemble
  \bexecute\b\s*
  ##!=>
  ##! target: a function-call paren, or an (optionally backtick-quoted) identifier
  ##!> assemble
    \(
    \s*[\w\.$]+\s*
    `\s*[\w\.$]+\s*`
  ##!<
##!<

##!> assemble
  \bcreate\b\s+\btable\b
  ##!=>
  ##! target: any non-paren content, or a backtick-quoted table name
  ##!> assemble
    [^(]+\(
    \s*`\s*[^\s`]+\s*`\s*\(
  ##!<
##!<

\blike\W*?char\W*?\(
\bselect\b.+?\bcase\b
\bfrom\b.*?\blimit\b
\bfrom\b.+?\bgroup\b\s+\bby\b
##! Commented out because it's prone to FPs.
##! \bfrom\b.*?\bwhere\b
\border\b\s+\bby\b
\bexists\b\s+\bselect\b
\bexists\b\s+\bsystem\s*\(
\bexists\b\s+\bhaving\b\s+(?:\d+|true)
\bexists\b\s+['"][^=]+['"]
\bexists\s*\(\s*select\b
